# ─── Variables d'environnement ──────────────────────────────────────────────
# Copie ce fichier en .env et remplace les valeurs

# CoinGecko API (gratuite, pas de clé requise)
VITE_COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# OpenAI API — OBLIGATOIRE pour la page IA (côté serveur uniquement)
# ⚠️ Ne JAMAIS préfixer par VITE_ : toute variable VITE_* est copiée en clair
#    dans le JavaScript public envoyé au navigateur.
# Utilisée par la fonction serverless api/recommend.ts (Vercel).
# En local : lancer `vercel dev` pour que /api/recommend fonctionne.
OPENAI_API_KEY=sk-your-openai-api-key-here
